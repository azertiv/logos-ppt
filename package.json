{
  "name": "logos-ppt",
  "version": "1.1.1",
  "private": true,
  "description": "Office.js PowerPoint add-in to browse and insert pictogram logos.",
  "scripts": {
    "start": "node server.js",
    "build:pages": "node scripts/build-pages.js",
    "wordnet:build": "node scripts/build-wordnet-synonyms.mjs",
    "keywords:generate": "node scripts/generate-keywords.mjs",
    "dev-certs": "npx office-addin-dev-certs install --days 365",
    "verify-certs": "npx office-addin-dev-certs verify",
    "companion": "node bridge/server.js --open",
    "companion:check": "node bridge/diagnose.js",
    "test": "node --test tests/*.test.js",
    "package:windows": "python3 scripts/package-companion.py",
    "build:windows": "dotnet build bridge/windows/Neurow.Pictos.csproj -c Release"
  },
  "dependencies": {
    "express": "^4.19.2",
    "office-addin-dev-certs": "^1.12.1"
  }
}
